{"row_id": "3731", "input": {"id": "3731", "web_name": "人民法院案例库", "case_type": "刑事-抢劫罪", "storage_no": "2023-06-1-220-003"}, "output": {"guiding_case": {"guiding_case_number": "", "guiding_case_name": "王某红、徐某抢劫案", "publication_date": "", "binding_force": "reference", "guiding_points": "1.被告人在法定期限内口头提出上诉的，应视为有效上诉。\n2.死刑上诉案件未开庭审理的，属于严重违反法定诉讼程序，可能影响公正审判，应依法发回重审。", "key_words": ["刑事", "抢劫罪", "口头上诉", "上诉权", "死刑案件", "二审开庭"], "case_level": "reference_case", "trial_procedure": "二审", "storage_no": "2023-06-1-220-003", "source_url": "", "judgment_mean": ""}, "case_type": {"category": "criminal", "level1": "抢劫罪", "level2": "抢劫罪"}, "court_cases": [{"case_number": "（2014）渭中刑二初字第00032号", "filing_date": "2014-01-01", "judgment_date": "2014-12-09", "trial_level": "first_instance", "trial_procedure": "一审", "court": {"name": "陕西省渭南市中级人民法院", "court_level": "intermediate"}, "status": "judged"}, {"case_number": "（2015）陕刑一复字第00018号", "filing_date": "2015-01-01", "judgment_date": "2015-10-22", "trial_level": "second_instance", "trial_procedure": "二审（复核程序）", "court": {"name": "陕西省高级人民法院", "court_level": "high"}, "status": "judged"}], "legal_subjects": [{"name": "王某红", "subject_type": "natural_person", "org_type": null, "credit_code": null, "roles": [{"role_code": "defendant_criminal", "role_name": "被告人", "case_number": "（2014）渭中刑二初字第00032号"}, {"role_code": "defendant_criminal", "role_name": "被告人", "case_number": "（2015）陕刑一复字第00018号"}]}, {"name": "徐某", "subject_type": "natural_person", "org_type": null, "credit_code": null, "roles": [{"role_code": "defendant_criminal", "role_name": "被告人", "case_number": "（2014）渭中刑二初字第00032号"}, {"role_code": "defendant_criminal", "role_name": "被告人", "case_number": "（2015）陕刑一复字第00018号"}]}, {"name": "杜某红", "subject_type": "natural_person", "org_type": null, "credit_code": null, "roles": [{"role_code": "defendant_criminal", "role_name": "同案被告人", "case_number": "（2014）渭中刑二初字第00032号"}]}, {"name": "侯某某", "subject_type": "natural_person", "org_type": null, "credit_code": null, "roles": [{"role_code": "victim", "role_name": "被害人", "case_number": "（2014）渭中刑二初字第00032号"}]}, {"name": "袁某玲", "subject_type": "natural_person", "org_type": null, "credit_code": null, "roles": [{"role_code": "victim", "role_name": "被害人", "case_number": "（2014）渭中刑二初字第00032号"}]}, {"name": "樊某涛", "subject_type": "natural_person", "org_type": null, "credit_code": null, "roles": [{"role_code": "victim", "role_name": "被害人", "case_number": "（2014）渭中刑二初字第00032号"}]}, {"name": "刘某盈", "subject_type": "natural_person", "org_type": null, "credit_code": null, "roles": [{"role_code": "victim", "role_name": "被害人", "case_number": "（2014）渭中刑二初字第00032号"}]}], "attorneys": [], "judges": [], "prosecutors": [], "trial_organizations": [], "legal_provisions": [{"case_number": "（2014）渭中刑二初字第00032号", "statute": "刑法", "article": "263", "paragraph": "", "item": "5", "content": "抢劫致人重伤、死亡的", "citation_position": "related_law", "citation_purpose": "适用依据"}, {"case_number": "（2015）陕刑一复字第00018号", "statute": "刑事诉讼法", "article": "216", "paragraph": "1", "item": "", "content": "被告人、自诉人和他们的法定代理人，不服地方各级人民法院第一审的判决、裁定，有权用书状或者口头向上一级人民法院上诉。", "citation_position": "judgment_essence", "citation_purpose": "说理依据"}, {"case_number": "（2015）陕刑一复字第00018号", "statute": "刑事诉讼法", "article": "223", "paragraph": "1", "item": "2", "content": "第二审人民法院对于下列案件，应当组成合议庭，开庭审理……（二）被告人被判处死刑的上诉案件……", "citation_position": "judgment_essence", "citation_purpose": "说理依据"}, {"case_number": "（2015）陕刑一复字第00018号", "statute": "最高人民法院关于适用〈中华人民共和国刑事诉讼法〉的解释", "article": "300", "paragraph": "1", "item": "", "content": "人民法院受理的上诉案件，一般应当有上诉状正本及副本。", "citation_position": "judgment_essence", "citation_purpose": "说理依据"}, {"case_number": "（2015）陕刑一复字第00018号", "statute": "最高人民法院关于适用〈中华人民共和国刑事诉讼法〉的解释", "article": "317", "paragraph": "1", "item": "", "content": "被告人被判处死刑立即执行的上诉案件，应当开庭审理。", "citation_position": "judgment_essence", "citation_purpose": "说理依据"}], "evidence": [{"content": "侯某某的存折（8000元）", "evidence_type": "documentary", "submitted_by": "公诉机关", "is_key_evidence": true}, {"content": "侯某某、樊某涛、刘某盈的尸体检验报告", "evidence_type": "forensic", "submitted_by": "公安机关", "is_key_evidence": true}, {"content": "王某红银行账户转账记录（转入8万元）", "evidence_type": "electronic", "submitted_by": "银行", "is_key_evidence": true}, {"content": "杜某红证言（帮忙取款经过）", "evidence_type": "witness_testimony", "submitted_by": "杜某红", "is_key_evidence": false}], "judgment_results": [{"result_type": "convicted", "specific_judgment": "判处死刑，剥夺政治权利终身，并处没收个人全部财产。", "case_number": "（2014）渭中刑二初字第00032号"}, {"result_type": "fully_upheld", "specific_judgment": "驳回上诉，维持原判。", "case_number": "（2015）陕刑一复字第00018号"}], "case_summary": {"key_facts": "2012年12月至2013年3月，被告人王某红、徐某先后抢劫杀害侯某某、袁某玲、樊某涛及刘某盈，劫取财物价值17万余元。一审法院判处二人死刑。二人提出上诉，陕西省高级人民法院未开庭审理，直接裁定维持原判。最高人民法院以程序违法为由撤销原判，发回重审。", "disputed_issues": "1.被告人口头上诉是否有效；2.死刑案件二审未开庭审理是否构成程序违法。", "conclusion": "最高人民法院不核准死刑，撤销原判，发回重审，理由是一审宣判后被告人口头上诉有效，二审法院未开庭审理死刑上诉案件，严重违反法定程序，可能影响公正审判。", "amount_involved": "约17.8万元", "guiding_points": "1.被告人在法定期限内口头提出上诉的，应视为有效上诉。\n2.死刑上诉案件未开庭审理的，属于严重违反法定诉讼程序，可能影响公正审判，应依法发回重审。"}}, "eval": {"row_id": "3731", "score": 87.0, "issues": ["guiding_case_number 为空", "judges 为空", "attorneys 为空", "prosecutors 为空（刑事应包含公诉信息）", "trial_organizations 为空"], "court_case_count": 2, "judge_count": 0, "attorney_count": 0, "provision_count": 5, "evidence_count": 4}}
{"row_id": "4365", "input": {"id": "4365", "web_name": "人民法院案例库", "case_type": "刑事-以危险方法危害公共安全罪", "storage_no": "2023-06-1-017-001"}, "output": {"guiding_case": {"guiding_case_number": "", "guiding_case_name": "张某海等以危险方法危害公共安全案", "publication_date": "", "binding_force": "typical_case", "guiding_points": "危险驾驶罪与以危险方法危害公共安全罪都属于危险犯，侵害客体都是公共安全，区分关键在于危险驾驶行为的危害程度是否与以危险方法危害公共安全罪规定的“放火、决水、爆炸、投放危险物质”的危险程度相当。对于危害程度与以危险方法危害公共安全罪规定的上述行为的危险程度相当的危险驾驶行为，可考虑按以危险方法危害公共安全罪定罪处罚。", "key_words": [], "case_level": "typical_case", "trial_procedure": "二审", "storage_no": "2023-06-1-017-001", "source_url": "", "judgment_mean": ""}, "case_type": {"category": "criminal", "level1": "以危险方法危害公共安全罪", "level2": ""}, "court_cases": [{"case_number": "(2021)浙0681刑初922号", "filing_date": "2021-01-01", "judgment_date": "2021-10-19", "trial_level": "first_instance", "trial_procedure": "一审", "court": {"name": "浙江省诸暨市人民法院", "court_level": "basic"}, "status": "judged"}, {"case_number": "(2021)浙06刑终317号", "filing_date": "2021-01-01", "judgment_date": "2021-11-25", "trial_level": "second_instance", "trial_procedure": "二审", "court": {"name": "浙江省绍兴市中级人民法院", "court_level": "intermediate"}, "status": "effective"}], "legal_subjects": [{"name": "张某海", "subject_type": "natural_person", "org_type": null, "credit_code": null, "roles": [{"role_code": "defendant_criminal", "role_name": "被告人", "case_number": "(2021)浙0681刑初922号"}, {"role_code": "defendant_criminal", "role_name": "原审被告人", "case_number": "(2021)浙06刑终317号"}]}, {"name": "王某祥", "subject_type": "natural_person", "org_type": null, "credit_code": null, "roles": [{"role_code": "defendant_criminal", "role_name": "被告人", "case_number": "(2021)浙0681刑初922号"}, {"role_code": "appellant", "role_name": "上诉人", "case_number": "(2021)浙06刑终317号"}]}, {"name": "范某", "subject_type": "natural_person", "org_type": null, "credit_code": null, "roles": [{"role_code": "witness", "role_name": "另案处理人员/证人", "case_number": "(2021)浙0681刑初922号"}]}, {"name": "白某东", "subject_type": "natural_person", "org_type": null, "credit_code": null, "roles": [{"role_code": "witness", "role_name": "另案处理人员/证人", "case_number": "(2021)浙0681刑初922号"}]}, {"name": "钟某亮", "subject_type": "natural_person", "org_type": null, "credit_code": null, "roles": [{"role_code": "victim", "role_name": "被害人", "case_number": "(2021)浙0681刑初922号"}]}, {"name": "钟某龙", "subject_type": "natural_person", "org_type": null, "credit_code": null, "roles": [{"role_code": "victim", "role_name": "被害人", "case_number": "(2021)浙0681刑初922号"}]}], "attorneys": [], "judges": [], "prosecutors": [], "trial_organizations": [], "legal_provisions": [{"case_number": "(2021)浙06刑终317号", "statute": "刑法", "article": "114", "paragraph": "", "item": "", "content": "刑法第一百一十四条将其与放火、决水、爆炸以及投放为危险物质等行为并列列举，并规定了较高的法定刑，造成严重危害后果的，法定刑升档。", "citation_position": "judgment_reason", "citation_purpose": "适用依据"}, {"case_number": "(2021)浙06刑终317号", "statute": "刑法", "article": "115", "paragraph": "", "item": "", "content": "造成严重危害后果的，法定刑升档。", "citation_position": "judgment_reason", "citation_purpose": "适用依据"}], "evidence": [{"content": "诸暨市公安局交通警察大队出具的道路交通事故认定书，认定张某海负本次事故的全部责任，钟某亮、钟某龙无责任。", "evidence_type": "documentary", "submitted_by": "公诉机关", "is_key_evidence": true}, {"content": "被告人车辆在2021年4月19日至4月28日六次运输中累计闯红灯300余次的监控记录、行车数据等。", "evidence_type": "electronic", "submitted_by": "公诉机关", "is_key_evidence": true}], "judgment_results": [{"result_type": "convicted", "specific_judgment": "一、被告人张某海犯以危险方法危害公共安全罪，判处有期徒刑七年六个月。二、被告人王某祥犯以危险方法危害公共安全罪，判处有期徒刑四年六个月。三、禁止被告人张某海、王某祥自刑罚执行完毕之日或者假释之日起四年内从事交通运输相关职业。", "case_number": "(2021)浙0681刑初922号"}, {"result_type": "fully_upheld", "specific_judgment": "准许上诉人王某祥撤回上诉。", "case_number": "(2021)浙06刑终317号"}], "case_summary": {"key_facts": "张某海、王某祥长期从事重型自卸货车运输，为追求更大利润，组织车队严重超载（约核定载量4倍），遮挡号牌，由王某祥驾驶带路车，张某海、范某、白某东驾驶严重超载货车跟随，通过连续闯红灯、随意变道等方式逃避检查并加快运输。2021年4月28日晚，张某海驾驶严重超载货车在诸暨市一路口闯红灯，与左转弯轿车碰撞，致一人死亡、一人受伤。经认定张某海负全责。此前六次运输中累计闯红灯300余次。", "disputed_issues": "被告人的行为构成交通肇事罪、危险驾驶罪还是以危险方法危害公共安全罪？辩护人主张应认定为交通肇事或危险驾驶。", "conclusion": "法院生效裁判认定被告人以非法牟利为目的，在较长时间内连续、高频次实施严重超载、遮挡号牌、闯红灯等危险驾驶行为，严重危害公共安全，造成严重后果，其行为构成以危险方法危害公共安全罪。分别判处张某海、王某祥有期徒刑七年六个月和四年六个月，并禁止四年内从事交通运输职业。二审准许王某祥撤回上诉，维持原判。", "amount_involved": "", "guiding_points": "危险驾驶罪与以危险方法危害公共安全罪区分的关键在于危险驾驶行为的危害程度是否与“放火、决水、爆炸、投放危险物质”的危险程度相当。对于危险程度相当的，可定以危险方法危害公共安全罪。"}}, "eval": {"row_id": "4365", "score": 87.0, "issues": ["guiding_case_number 为空", "judges 为空", "attorneys 为空", "prosecutors 为空（刑事应包含公诉信息）", "trial_organizations 为空"], "court_case_count": 2, "judge_count": 0, "attorney_count": 0, "provision_count": 2, "evidence_count": 2}}
{"row_id": "34436", "input": {"id": "34436", "web_name": "人民法院案例库", "case_type": "刑事-故意毁坏财物罪", "storage_no": "2026-05-1-230-001"}, "output": {"guiding_case": {"guiding_case_number": "", "guiding_case_name": "李某等故意毁坏财物案", "publication_date": "2020-12-23", "binding_force": "persuasive", "guiding_points": "对于刑法第二百七十五条规定的故意毁坏财物罪“数额较大”和有“其他严重情节”的入罪标准，在认定罪与非罪时应当作体系性把握。在参照适用《最高人民检察院、公安部关于公安机关管辖的刑事案件立案追诉标准的规定（一）》第三十三条时，应当遵循罪责刑相适应原则和体系解释的要求，不能唯次数论；对于故意毁坏公私财物的次数虽然在三次以上，但是造成公私财物损失明显低于五千元的，不能仅以故意毁坏公私财物在三次以上为由予以定罪处罚。", "key_words": [], "case_level": "typical_case", "trial_procedure": "二审", "storage_no": "2026-05-1-230-001", "source_url": "", "judgment_mean": ""}, "case_type": {"category": "criminal", "level1": "故意毁坏财物罪", "level2": ""}, "court_cases": [{"case_number": "(2017)闽0213刑初289号", "filing_date": "2017-01-01", "judgment_date": "2018-01-23", "trial_level": "first_instance", "trial_procedure": "一审", "court": {"name": "福建省厦门市翔安区人民法院", "court_level": "basic"}, "status": "effective"}, {"case_number": "(2018)闽02刑终192号", "filing_date": "2018-01-01", "judgment_date": "2018-06-01", "trial_level": "second_instance", "trial_procedure": "二审", "court": {"name": "福建省厦门市中级人民法院", "court_level": "intermediate"}, "status": "effective"}, {"case_number": "(2018)闽0213刑初365号", "filing_date": "2018-01-01", "judgment_date": "2019-05-13", "trial_level": "first_instance", "trial_procedure": "重审一审", "court": {"name": "福建省厦门市翔安区人民法院", "court_level": "basic"}, "status": "effective"}, {"case_number": "(2019)闽02刑终413号", "filing_date": "2019-01-01", "judgment_date": "2020-12-23", "trial_level": "second_instance", "trial_procedure": "重审二审", "court": {"name": "福建省厦门市中级人民法院", "court_level": "intermediate"}, "status": "effective"}], "legal_subjects": [{"name": "李某", "subject_type": "natural_person", "org_type": null, "credit_code": null, "roles": [{"role_code": "defendant_criminal", "role_name": "被告人", "case_number": "(2017)闽0213刑初289号"}, {"role_code": "defendant_criminal", "role_name": "被告人", "case_number": "(2018)闽02刑终192号"}, {"role_code": "defendant_criminal", "role_name": "被告人", "case_number": "(2018)闽0213刑初365号"}, {"role_code": "respondent", "role_name": "被上诉人", "case_number": "(2019)闽02刑终413号"}]}, {"name": "牛某斌", "subject_type": "natural_person", "org_type": null, "credit_code": null, "roles": [{"role_code": "defendant_criminal", "role_name": "被告人", "case_number": "(2017)闽0213刑初289号"}, {"role_code": "appellant", "role_name": "上诉人", "case_number": "(2018)闽02刑终192号"}, {"role_code": "defendant_criminal", "role_name": "被告人", "case_number": "(2018)闽0213刑初365号"}, {"role_code": "appellant", "role_name": "上诉人", "case_number": "(2019)闽02刑终413号"}]}, {"name": "王某锁", "subject_type": "natural_person", "org_type": null, "credit_code": null, "roles": [{"role_code": "defendant_criminal", "role_name": "被告人", "case_number": "(2017)闽0213刑初289号"}, {"role_code": "appellant", "role_name": "上诉人", "case_number": "(2018)闽02刑终192号"}, {"role_code": "defendant_criminal", "role_name": "被告人", "case_number": "(2018)闽0213刑初365号"}, {"role_code": "respondent", "role_name": "被抗诉人", "case_number": "(2019)闽02刑终413号"}]}, {"name": "林某域", "subject_type": "natural_person", "org_type": null, "credit_code": null, "roles": [{"role_code": "defendant_criminal", "role_name": "被告人", "case_number": "(2017)闽0213刑初289号"}, {"role_code": "defendant_criminal", "role_name": "被告人", "case_number": "(2018)闽02刑终192号"}, {"role_code": "defendant_criminal", "role_name": "被告人", "case_number": "(2018)闽0213刑初365号"}, {"role_code": "respondent", "role_name": "被上诉人", "case_number": "(2019)闽02刑终413号"}]}, {"name": "某体育公司", "subject_type": "organization", "org_type": "company", "credit_code": null, "roles": [{"role_code": "victim", "role_name": "被害单位", "case_number": "(2017)闽0213刑初289号"}, {"role_code": "victim", "role_name": "被害单位", "case_number": "(2018)闽02刑终192号"}, {"role_code": "victim", "role_name": "被害单位", "case_number": "(2018)闽0213刑初365号"}, {"role_code": "victim", "role_name": "被害单位", "case_number": "(2019)闽02刑终413号"}]}, {"name": "福建省厦门市翔安区人民检察院", "subject_type": "organization", "org_type": "procuratorate", "credit_code": null, "roles": [{"role_code": "prosecutor", "role_name": "公诉机关", "case_number": "(2017)闽0213刑初289号"}, {"role_code": "prosecutor", "role_name": "公诉机关", "case_number": "(2018)闽0213刑初365号"}, {"role_code": "prosecutor", "role_name": "抗诉机关", "case_number": "(2019)闽02刑终413号"}]}], "attorneys": [], "judges": [], "prosecutors": [{"name": "", "role": "public_prosecutor", "unit": "福建省厦门市翔安区人民检察院", "case_number": "(2017)闽0213刑初289号"}, {"name": "", "role": "public_prosecutor", "unit": "福建省厦门市翔安区人民检察院", "case_number": "(2018)闽0213刑初365号"}, {"name": "", "role": "protest_organ", "unit": "福建省厦门市翔安区人民检察院", "case_number": "(2019)闽02刑终413号"}], "trial_organizations": [], "legal_provisions": [{"case_number": "(2019)闽02刑终413号", "statute": "中华人民共和国刑法", "article": "275", "paragraph": "", "item": "", "content": "故意毁坏公私财物，数额较大或者有其他严重情节的，处三年以下有期徒刑、拘役或者罚金；数额巨大或者有其他特别严重情节的，处三年以上七年以下有期徒刑。", "citation_position": "judgment_reason", "citation_purpose": "说理依据"}, {"case_number": "(2019)闽02刑终413号", "statute": "中华人民共和国刑法", "article": "13", "paragraph": "", "item": "", "content": "一切危害国家主权、领土完整和安全，分裂国家、颠覆人民民主专政的政权和推翻社会主义制度，破坏社会秩序和经济秩序，侵犯国有财产或者劳动群众集体所有的财产，侵犯公民私人所有的财产，侵犯公民的人身权利、民主权利和其他权利，以及其他危害社会的行为，依照法律应当受刑罚处罚的，都是犯罪，但是情节显著轻微危害不大的，不认为是犯罪。", "citation_position": "judgment_reason", "citation_purpose": "说理依据"}, {"case_number": "(2019)闽02刑终413号", "statute": "最高人民检察院、公安部关于公安机关管辖的刑事案件立案追诉标准的规定（一）", "article": "33", "paragraph": "", "item": "", "content": "故意毁坏公私财物，涉嫌下列情形之一的，应予立案追诉：（一）造成公私财物损失五千元以上的；（二）毁坏公私财物三次以上的；（三）纠集三人以上公然毁坏公私财物的；（四）其他情节严重的情形。", "citation_position": "judgment_reason", "citation_purpose": "说理依据"}, {"case_number": "(2019)闽02刑终413号", "statute": "最高人民法院关于在经济犯罪审判中参照适用《最高人民检察院、公安部关于公安机关管辖的刑事案件立案追诉标准的规定（二）》的通知", "article": "", "paragraph": "", "item": "", "content": "最高人民法院对相关经济犯罪的定罪量刑标准没有规定的，人民法院在审理经济犯罪案件时，可以参照适用有关立案追诉标准的规定。", "citation_position": "judgment_reason", "citation_purpose": "说理依据"}, {"case_number": "(2019)闽02刑终413号", "statute": "中华人民共和国刑法", "article": "275", "paragraph": "", "item": "", "content": "故意毁坏财物罪“数额较大”和有“其他严重情节”的入罪标准，在认定罪与非罪时应当作体系性把握。", "citation_position": "judgment_essence", "citation_purpose": "说理依据"}], "evidence": [{"content": "被毁坏的游泳培训广告布价值鉴定意见，价值合计1699元", "evidence_type": "forensic", "submitted_by": "公安机关", "is_key_evidence": true}, {"content": "被告人李某向某体育公司支付赔偿款30000元的凭证", "evidence_type": "documentary", "submitted_by": "李某", "is_key_evidence": false}, {"content": "被告人林某域向某体育公司支付赔偿款8000元的凭证", "evidence_type": "documentary", "submitted_by": "林某域", "is_key_evidence": false}, {"content": "某体育公司出具的谅解书，对李某、林某域表示谅解", "evidence_type": "documentary", "submitted_by": "某体育公司", "is_key_evidence": false}], "judgment_results": [{"result_type": "convicted", "specific_judgment": "被告人李某犯故意毁坏财物罪，判处罚金人民币五千元；被告人牛某斌犯故意毁坏财物罪，判处罚金人民币四千元；被告人王某锁犯故意毁坏财物罪，判处罚金人民币四千元；被告人林某域犯故意毁坏财物罪，判处罚金人民币三千元。", "case_number": "(2017)闽0213刑初289号"}, {"result_type": "remanded", "specific_judgment": "撤销原判，发回厦门市翔安区人民法院重新审判。", "case_number": "(2018)闽02刑终192号"}, {"result_type": "convicted", "specific_judgment": "被告人李某、牛某斌合谋指使林某域四次实施破坏广告布的行为，均构成故意毁坏财物罪，免予刑事处罚；被告人林某域免予刑事处罚；被告人王某锁无罪。", "case_number": "(2018)闽0213刑初365号"}, {"result_type": "partially_upheld", "specific_judgment": "驳回抗诉，维持被告人王某锁无罪判项；改判被告人李某、牛某斌、林某域无罪。", "case_number": "(2019)闽02刑终413号"}], "case_summary": {"key_facts": "某体育公司承包游泳馆场地开展培训。李某、牛某斌、王某锁原为该公司教练，后因工资纠纷离职，自2016年4月合伙通过购票入场培训。2016年5月14日，该公司悬挂低价广告布，李某等人认为影响招生，于5月15日至6月2日指使林某域或由李某多次毁坏广告布。其中李某毁坏2次，价值460元；林某域受指使毁坏4次，价值1239元。案发后李某、林某域赔偿共3.8万元并获谅解。", "disputed_issues": "如何把握故意毁坏财物罪中“其他严重情节”的入罪标准，毁坏财物次数三次以上但损失明显低于数额较大标准（5000元）的，能否定罪。", "conclusion": "厦门市中级人民法院重审二审认为，李某等人毁坏财物价值1699元，远低于5000元的数额较大标准，且行为的社会危害性和刑事处罚必要性明显较低，情节显著轻微，不构成犯罪，改判李某、牛某斌、林某域无罪；维持王某锁无罪。", "amount_involved": "1699元", "guiding_points": "对于刑法第二百七十五条规定的故意毁坏财物罪“数额较大”和有“其他严重情节”的入罪标准，在认定罪与非罪时应当作体系性把握。在参照适用《最高人民检察院、公安部关于公安机关管辖的刑事案件立案追诉标准的规定（一）》第三十三条时，应当遵循罪责刑相适应原则和体系解释的要求，不能唯次数论；对于故意毁坏公私财物的次数虽然在三次以上，但是造成公私财物损失明显低于五千元的，不能仅以故意毁坏公私财物在三次以上为由予以定罪处罚。"}}, "eval": {"row_id": "34436", "score": 84.0, "issues": ["guiding_case_number 为空", "judges 为空", "attorneys 为空", "trial_organizations 为空", "legal_provisions[3].article 为空"], "court_case_count": 4, "judge_count": 0, "attorney_count": 0, "provision_count": 5, "evidence_count": 4}}
{"row_id": "1146", "input": {"id": "1146", "web_name": "人民法院案例库", "case_type": "民事-环境污染责任纠纷", "storage_no": "2024-11-2-377-010"}, "output": {"guiding_case": {"guiding_case_number": "", "guiding_case_name": "上海某村民委员会诉张某等环境污染责任纠纷案", "publication_date": "2020-01-30", "binding_force": "reference", "guiding_points": "当危险废物产生者不履行危险废物处置义务时，被侵权人代为处置所产生的合理费用应当由危险废物产生者承担。危险废物产生者以其已承担刑事责任为由对民事责任的承担提出抗辩的，人民法院不予支持。", "key_words": ["环境污染", "危险废物", "连带责任", "刑事责任抗辩", "处置费用"], "case_level": "typical_case", "trial_procedure": "一审", "storage_no": "2024-11-2-377-010", "source_url": "", "judgment_mean": ""}, "case_type": {"category": "civil", "level1": "环境污染责任纠纷", "level2": ""}, "court_cases": [{"case_number": "(2019)沪0151民初3894号", "filing_date": "2019-01-01", "judgment_date": "2019-12-25", "trial_level": "first_instance", "trial_procedure": "一审", "court": {"name": "上海市崇明区人民法院", "court_level": "basic"}, "status": "effective"}, {"case_number": "(2019)沪0151民初1584号", "filing_date": "2019-01-01", "judgment_date": "", "trial_level": "first_instance", "trial_procedure": "一审", "court": {"name": "上海市崇明区人民法院", "court_level": "basic"}, "status": "effective"}], "legal_subjects": [{"name": "上海某村民委员会", "subject_type": "organization", "org_type": "government_agency", "credit_code": null, "roles": [{"role_code": "plaintiff", "role_name": "原告", "case_number": "(2019)沪0151民初3894号"}, {"role_code": "respondent", "role_name": "被执行人", "case_number": "(2019)沪0151民初1584号"}]}, {"name": "张某", "subject_type": "natural_person", "org_type": null, "credit_code": null, "roles": [{"role_code": "defendant", "role_name": "被告", "case_number": "(2019)沪0151民初3894号"}]}, {"name": "龙某祥", "subject_type": "natural_person", "org_type": null, "credit_code": null, "roles": [{"role_code": "defendant", "role_name": "被告", "case_number": "(2019)沪0151民初3894号"}]}, {"name": "徐某忠", "subject_type": "natural_person", "org_type": null, "credit_code": null, "roles": [{"role_code": "defendant", "role_name": "被告", "case_number": "(2019)沪0151民初3894号"}]}, {"name": "某固体废物处理公司", "subject_type": "organization", "org_type": "company", "credit_code": null, "roles": [{"role_code": "plaintiff", "role_name": "原告", "case_number": "(2019)沪0151民初1584号"}]}], "attorneys": [], "judges": [], "prosecutors": [], "trial_organizations": [], "legal_provisions": [{"case_number": "(2019)沪0151民初3894号", "statute": "侵权责任法", "article": "4", "paragraph": "", "item": "", "content": "侵权人因同一行为应当承担行政责任或者刑事责任的，不影响依法承担侵权责任。", "citation_position": "judgment_reason", "citation_purpose": "适用依据"}, {"case_number": "(2019)沪0151民初3894号", "statute": "侵权责任法", "article": "65", "paragraph": "", "item": "", "content": "因污染环境造成损害的，污染者应当承担侵权责任。", "citation_position": "judgment_reason", "citation_purpose": "适用依据"}, {"case_number": "(2019)沪0151民初3894号", "statute": "固体废物污染环境防治法", "article": "55", "paragraph": "", "item": "", "content": "产生危险废物的单位，必须按照国家有关规定处置危险废物，不得擅自倾倒、堆放；不处置的，由所在地县级以上地方人民政府环境保护行政主管部门责令限期改正；逾期不处置或者处置不符合国家有关规定的，由所在地县级以上地方人民政府环境保护行政主管部门指定单位按照国家有关规定代为处置，处置费用由产生危险废物的单位承担。", "citation_position": "judgment_essence", "citation_purpose": "适用依据"}], "evidence": [{"content": "环保部门会同公安机关查获大量废电子元件及炉渣灰，经认定属于危险废物，废物代码900-045-49、321-024-48。", "evidence_type": "documentary", "submitted_by": "原告", "is_key_evidence": true}, {"content": "危险废物堆放处周边土壤检测报告，显示铜、镉、锌等元素超过《上海市场地土壤环境健康风险评估筛选值（试行）》相应标准。", "evidence_type": "forensic", "submitted_by": "原告", "is_key_evidence": true}, {"content": "张某2018年5月22日、6月15日公安讯问笔录，陈述龙某祥生产情况。", "evidence_type": "witness_testimony", "submitted_by": "原告", "is_key_evidence": false}, {"content": "上海某村民委员会与某固体废物处理公司签订的《工业废弃物收集、处置、运输合同》，约定处置单价。", "evidence_type": "documentary", "submitted_by": "原告", "is_key_evidence": true}, {"content": "(2019)沪0151民初1584号民事判决书，认定处置危废数量及费用。", "evidence_type": "documentary", "submitted_by": "原告", "is_key_evidence": true}, {"content": "案外人上海市崇明区长兴镇人民政府委托上海某环境科技有限公司出具的土壤鉴定报告，确认危废处理后土壤指标恢复正常。", "evidence_type": "forensic", "submitted_by": "原告", "is_key_evidence": false}], "judgment_results": [{"result_type": "liable", "specific_judgment": "一、张某于判决生效之日起十日内支付上海某村民委员会危废处理、土壤修复费用人民币437024.25元；二、张某、龙某祥于判决生效之日起十日内共同支付上海某村民委员会危废处理费用人民币2698602.75元；三、驳回上海某村民委员会其余诉讼请求。", "case_number": "(2019)沪0151民初3894号"}], "case_summary": {"key_facts": "徐某忠将承租的上海崇明长兴镇老窑厂地块房屋转租。2016年起，张某未办环保审批，利用该处厂房非法火法炼铝，并随意倾倒炉渣灰。2017年4月，龙某祥转租部分厂房从事类似生产，后停产。环保部门会同公安查获废电子元件55.05吨、炉渣灰481.79吨，均属危险废物，造成土壤污染。张某因污染环境罪被判刑。上海某村民委员会委托处置危废，支付处置费3103493元及杂费32134元，后起诉要求张某、龙某祥、徐某忠赔偿上述费用。", "disputed_issues": "1. 徐某忠作为出租人是否应承担污染侵权责任；2. 张某与龙某祥的责任如何划分；3. 张某已承担刑事责任能否免除民事责任。", "conclusion": "张某个人承担废电子元件处理费用及相应杂费共437024.25元；张某与龙某祥共同承担炉渣灰处理费用及相应杂费共2698602.75元；驳回对徐某忠的诉讼请求。张某的刑事责任不免除其民事赔偿责任。", "amount_involved": "3135627元", "guiding_points": "当危险废物产生者不履行危险废物处置义务时，被侵权人代为处置所产生的合理费用应当由危险废物产生者承担。危险废物产生者以其已承担刑事责任为由对民事责任的承担提出抗辩的，人民法院不予支持。"}}, "eval": {"row_id": "1146", "score": 89.0, "issues": ["guiding_case_number 为空", "judges 为空", "attorneys 为空", "trial_organizations 为空"], "court_case_count": 2, "judge_count": 0, "attorney_count": 0, "provision_count": 3, "evidence_count": 6}}
{"row_id": "3728", "input": {"id": "3728", "web_name": "人民法院案例库", "case_type": "刑事-非法吸收公众存款罪", "storage_no": "2023-04-1-113-001"}, "output": {"guiding_case": {"guiding_case_number": "", "guiding_case_name": "丁某忠等非法吸收公众存款案", "publication_date": "2022-10-28", "binding_force": "persuasive", "guiding_points": "1.刑行交叉下同一行为的认定。同一行为既构成行政违法行为，又构成刑事犯罪时，程序上适用刑事优先处理原则。对“同一行为”的认定，在实体判断层面应坚持罪刑法定原则，即构成行政违法的行为，能够作为犯罪构成要件全部被某一具体犯罪构成所涵摄。2.非法吸收公众存款罪的构成要件行为属于复合行为，不仅包括吸收募集资金的行为，还包括为吸收募集资金所进行的公开宣传诱导行为。两者在事实层面属于同一行为。3.关于退赔被害人的执行顺位。按照同一行为刑行竞合情形下移交刑事处理原则，在案件已定性为刑事犯罪的情况下，应当在刑事程序框架下对涉案财产进行处置。依照《最高人民法院关于刑事裁判涉财产部分执行的若干规定》第十三条之规定，被执行人在执行中同时承担刑事责任、民事责任，其财产不足以支付的，按照下列顺序执行：…（二）退赔被害人的损失；…（四）罚金；（五）没收财产，在执行顺位上退赔集资参与人应当优先于罚金和没收财产的执行。", "key_words": ["非法吸收公众存款", "刑行交叉", "退赔顺位", "虚拟货币"], "case_level": "typical_case", "trial_procedure": "二审", "storage_no": "2023-04-1-113-001", "source_url": "", "judgment_mean": ""}, "case_type": {"category": "criminal", "level1": "非法吸收公众存款罪", "level2": ""}, "court_cases": [{"case_number": "（2022）鄂0923刑初153号", "filing_date": "2022-01-01", "judgment_date": "2022-08-19", "trial_level": "first_instance", "trial_procedure": "一审", "court": {"name": "湖北省云梦县人民法院", "court_level": "basic"}, "status": "effective"}, {"case_number": "（2022）鄂09刑终175号", "filing_date": "2022-01-01", "judgment_date": "2022-10-28", "trial_level": "second_instance", "trial_procedure": "二审", "court": {"name": "湖北省孝感市中级人民法院", "court_level": "intermediate"}, "status": "effective"}], "legal_subjects": [{"name": "丁某忠", "subject_type": "natural_person", "org_type": null, "credit_code": null, "roles": [{"role_code": "defendant_criminal", "role_name": "被告人", "case_number": "（2022）鄂0923刑初153号"}, {"role_code": "appellant", "role_name": "上诉人", "case_number": "（2022）鄂09刑终175号"}]}, {"name": "任某宏", "subject_type": "natural_person", "org_type": null, "credit_code": null, "roles": [{"role_code": "defendant_criminal", "role_name": "被告人", "case_number": "（2022）鄂0923刑初153号"}, {"role_code": "appellant", "role_name": "上诉人", "case_number": "（2022）鄂09刑终175号"}]}, {"name": "徐某艳", "subject_type": "natural_person", "org_type": null, "credit_code": null, "roles": [{"role_code": "defendant_criminal", "role_name": "被告人", "case_number": "（2022）鄂0923刑初153号"}, {"role_code": "appellant", "role_name": "上诉人", "case_number": "（2022）鄂09刑终175号"}]}, {"name": "宋某领", "subject_type": "natural_person", "org_type": null, "credit_code": null, "roles": [{"role_code": "defendant_criminal", "role_name": "被告人", "case_number": "（2022）鄂0923刑初153号"}, {"role_code": "appellant", "role_name": "上诉人", "case_number": "（2022）鄂09刑终175号"}]}, {"name": "康某玮", "subject_type": "natural_person", "org_type": null, "credit_code": null, "roles": [{"role_code": "defendant_criminal", "role_name": "被告人", "case_number": "（2022）鄂0923刑初153号"}, {"role_code": "appellant", "role_name": "上诉人", "case_number": "（2022）鄂09刑终175号"}]}, {"name": "王某廷", "subject_type": "natural_person", "org_type": null, "credit_code": null, "roles": [{"role_code": "defendant_criminal", "role_name": "被告人", "case_number": "（2022）鄂0923刑初153号"}, {"role_code": "appellant", "role_name": "上诉人", "case_number": "（2022）鄂09刑终175号"}]}, {"name": "集资参与人", "subject_type": "organization", "org_type": null, "credit_code": null, "roles": [{"role_code": "victim", "role_name": "被害人", "case_number": "（2022）鄂0923刑初153号"}]}], "attorneys": [], "judges": [], "prosecutors": [], "trial_organizations": [], "legal_provisions": [{"case_number": "（2022）鄂0923刑初153号", "statute": "中华人民共和国刑法", "article": "176", "paragraph": "", "item": "", "content": "该行为属于以虚拟币交易方式非法吸收公众资金，构成非法吸收公众存款罪。", "citation_position": "judgment_reason", "citation_purpose": "适用依据"}, {"case_number": "（2022）鄂0923刑初153号", "statute": "中华人民共和国刑法", "article": "64", "paragraph": "", "item": "", "content": "依照《中华人民共和国刑法》第六十四条之规定，前述违法所得资金应当返还集资参与人，不足部分由丁某忠等人退赔。", "citation_position": "judgment_reason", "citation_purpose": "适用依据"}, {"case_number": "（2022）鄂0923刑初153号", "statute": "中华人民共和国行政处罚法", "article": "27", "paragraph": "", "item": "", "content": "对“同一行为”的认定，在实体判断层面应坚持罪刑法定原则，即构成行政违法的行为，能够作为犯罪构成要件全部被某一具体犯罪构成所涵摄。", "citation_position": "judgment_essence", "citation_purpose": "说理依据"}, {"case_number": "（2022）鄂0923刑初153号", "statute": "最高人民法院关于刑事裁判涉财产部分执行的若干规定", "article": "13", "paragraph": "", "item": "", "content": "被执行人在执行中同时承担刑事责任、民事责任，其财产不足以支付的，按照下列顺序执行：…（二）退赔被害人的损失；…（四）罚金；（五）没收财产。", "citation_position": "judgment_essence", "citation_purpose": "适用依据"}], "evidence": [{"content": "经审计，2020年5月1日至2021年6月8日，某云数字APP平台吸引全国477 720名消费会员购买“云元”113 933 646枚，销售金额共计人民币300 850 885.6元。", "evidence_type": "documentary", "submitted_by": "湖北省云梦县公安局", "is_key_evidence": true}, {"content": "2021年11月16日G市某区市场监督管理局作出行政处罚决定书，认定某云数字商品公司、某富商品公司违反《禁止传销条例》相关规定，属于组织策划传销的违法行为，并予以罚款及没收违法所得。", "evidence_type": "documentary", "submitted_by": "湖北省云梦县公安局", "is_key_evidence": true}], "judgment_results": [{"result_type": "convicted", "specific_judgment": "被告人丁某忠犯非法吸收公众存款罪，判处有期徒刑十三年，并处罚金一百万元；被告人任某宏犯非法吸收公众存款罪，判处有期徒刑十一年六个月，并处罚金八十万元；被告人徐某艳犯非法吸收公众存款罪，判处有期徒刑十一年六个月，并处罚金八十万元；被告人宋某领犯非法吸收公众存款罪，判处有期徒刑十一年六个月，并处罚金八十万元；被告人康某玮犯非法吸收公众存款罪，判处有期徒刑七年，并处罚金六十万元；被告人王某廷犯非法吸收公众存款罪，判处有期徒刑九年，并处罚金六十万元；对被告人非法吸收的资金及孳息依法予以追缴；对公安机关因该案查扣、冻结的财产由公安机关依法追缴后按比例发还给集资参与人，不足部分继续追缴，追缴财产返还集资参与人后剩余的部分上缴国库。", "case_number": "（2022）鄂0923刑初153号"}], "case_summary": {"key_facts": "2018年2月，丁某忠等人注册成立某云数字商品公司等关联公司，开发数字电商购物平台APP，以高额价差进行消费返利，并虚构只升不跌的虚拟货币“云元”诱使消费会员投资购买，变相吸收公众资金。2020年5月至2021年6月，平台吸收477720名会员购买云元1.13亿余枚，金额达3亿余元。2021年2月公安机关立案，同年11月市场监督管理局以传销作出行政处罚，没收违法所得近3亿元。公安机关冻结涉案资金2.35亿余元，后部分资金被法院依据行政处罚决定强制执行。2022年8月，一审法院以非法吸收公众存款罪判处丁某忠等人十三年至七年不等有期徒刑及罚金，追缴违法所得。被告人不服上诉。", "disputed_issues": "1.以虚拟货币交易方式吸收资金是否构成非法吸收公众存款罪；2.在已受行政处罚情况下，刑事追缴的违法所得如何处置及退赔顺位。", "conclusion": "驳回上诉，维持原判，即各被告人构成非法吸收公众存款罪，判处相应有期徒刑及罚金，追缴违法所得发还集资参与人。", "amount_involved": "300850885.6元", "guiding_points": "1.刑行交叉下同一行为的认定：同一行为既构成行政违法又构成刑事犯罪时，程序上刑事优先；实体认定坚持罪刑法定。2.非法吸收公众存款罪的复合行为包括吸收资金和公开宣传诱导行为，两者在事实上同一。3.退赔执行顺位：刑行竞合下应在刑事程序中处置涉案财产，退赔集资参与人优先于罚金和没收财产。"}}, "eval": {"row_id": "3728", "score": 87.0, "issues": ["guiding_case_number 为空", "judges 为空", "attorneys 为空", "prosecutors 为空（刑事应包含公诉信息）", "trial_organizations 为空"], "court_case_count": 2, "judge_count": 0, "attorney_count": 0, "provision_count": 4, "evidence_count": 2}}
{"row_id": "3906", "input": {"id": "3906", "web_name": "人民法院案例库", "case_type": "行政-专利相关行政案件", "storage_no": "2023-09-3-024-008"}, "output": {"guiding_case": {"guiding_case_number": "", "guiding_case_name": "某电脑贸易（上海）有限公司诉国家知识产权局专利复审委员会发明专利权无效行政纠纷案", "publication_date": "2020-03-27", "binding_force": "persuasive", "guiding_points": "本领域技术人员是否能够实现发明技术方案是判断说明书公开是否充分的根本落脚点。发明或者实用新型区别于现有技术的技术特征以及从属权利要求中的附加技术特征应当足够详细地描述，以所属技术领域的技术人员能够实现该技术方案为准。", "key_words": ["聊天机器人系统", "说明书公开充分", "游戏服务器", "格式化语句", "本领域技术人员"], "case_level": "typical_case", "trial_procedure": "再审", "storage_no": "2023-09-3-024-008", "source_url": "", "judgment_mean": "本领域技术人员是否能够实现发明技术方案是判断说明书公开是否充分的根本落脚点。发明或者实用新型区别于现有技术的技术特征以及从属权利要求中的附加技术特征应当足够详细地描述，以所属技术领域的技术人员能够实现该技术方案为准。"}, "case_type": {"category": "administrative", "level1": "行政", "level2": "专利相关行政案件"}, "court_cases": [{"case_number": "(2014)一中知行初字第184号", "filing_date": "2014-01-01", "judgment_date": "2014-04-28", "trial_level": "first_instance", "trial_procedure": "一审", "court": {"name": "北京市第一中级人民法院", "court_level": "intermediate"}, "status": "judged"}, {"case_number": "(2014)高行（知）终字第2935号", "filing_date": "2014-01-01", "judgment_date": "2015-04-21", "trial_level": "second_instance", "trial_procedure": "二审", "court": {"name": "北京市高级人民法院", "court_level": "high"}, "status": "judged"}, {"case_number": "(2017)最高法行再34号", "filing_date": "2017-01-01", "judgment_date": "2020-03-27", "trial_level": "retrial", "trial_procedure": "再审", "court": {"name": "最高人民法院", "court_level": "supreme"}, "status": "effective"}], "legal_subjects": [{"name": "某电脑贸易（上海）有限公司", "subject_type": "organization", "org_type": "company", "credit_code": null, "roles": [{"role_code": "plaintiff", "role_name": "原告", "case_number": "(2014)一中知行初字第184号"}, {"role_code": "appellant", "role_name": "上诉人", "case_number": "(2014)高行（知）终字第2935号"}, {"role_code": "retrial_respondent", "role_name": "再审被申请人", "case_number": "(2017)最高法行再34号"}]}, {"name": "国家知识产权局专利复审委员会", "subject_type": "organization", "org_type": "government_agency", "credit_code": null, "roles": [{"role_code": "defendant", "role_name": "被告", "case_number": "(2014)一中知行初字第184号"}, {"role_code": "appellee", "role_name": "被上诉人", "case_number": "(2014)高行（知）终字第2935号"}, {"role_code": "retrial_respondent", "role_name": "再审被申请人", "case_number": "(2017)最高法行再34号"}]}, {"name": "上海某网络科技股份有限公司", "subject_type": "organization", "org_type": "company", "credit_code": null, "roles": [{"role_code": "third_party", "role_name": "第三人", "case_number": "(2014)一中知行初字第184号"}, {"role_code": "appellee", "role_name": "被上诉人", "case_number": "(2014)高行（知）终字第2935号"}, {"role_code": "retrial_applicant", "role_name": "再审申请人", "case_number": "(2017)最高法行再34号"}]}], "attorneys": [], "judges": [], "prosecutors": [], "trial_organizations": [], "legal_provisions": [{"case_number": "(2017)最高法行再34号", "statute": "专利法", "article": "26", "paragraph": "3", "item": "", "content": "说明书应当对发明或者实用新型作出清楚、完整的说明，以所属技术领域的技术人员能够实现为准。", "citation_position": "judgment_reason", "citation_purpose": "适用依据"}, {"case_number": "(2017)最高法行再34号", "statute": "专利法", "article": "26", "paragraph": "3", "item": "", "content": "专利法第二十六条第三款规定，说明书应当对发明或者实用新型作出清楚、完整的说明，以所属技术领域的技术人员能够实现为准。", "citation_position": "basic_facts", "citation_purpose": "说理依据"}], "evidence": [{"content": "公开号为US2003/018239XA1的美国专利说明书及其中文译文", "evidence_type": "documentary", "submitted_by": "某电脑贸易（上海）有限公司", "is_key_evidence": true}, {"content": "授权公告号为CN257751X的中国实用新型专利说明书", "evidence_type": "documentary", "submitted_by": "某电脑贸易（上海）有限公司", "is_key_evidence": false}, {"content": "公开号为WO2004/04930XA1的专利说明书及其中文译文", "evidence_type": "documentary", "submitted_by": "某电脑贸易（上海）有限公司", "is_key_evidence": false}, {"content": "由国家知识产权局专利检索咨询中心出具的编号为G128870的检索报告", "evidence_type": "documentary", "submitted_by": "某电脑贸易（上海）有限公司", "is_key_evidence": false}, {"content": "（2015）沪科咨知鉴字第16号知识产权司法鉴定意见书及其所附本专利申请日之前的相关专业文献", "evidence_type": "expert_conclusion", "submitted_by": "上海某网络科技股份有限公司", "is_key_evidence": true}], "judgment_results": [{"result_type": "dismissed", "specific_judgment": "维持被诉决定，驳回某电脑贸易（上海）有限公司的诉讼请求。", "case_number": "(2014)一中知行初字第184号"}, {"result_type": "reversed", "specific_judgment": "撤销一审判决；撤销第21307号无效宣告请求审查决定；判令国家知识产权局专利复审委员会重新作出审查决定。", "case_number": "(2014)高行（知）终字第2935号"}, {"result_type": "reversed", "specific_judgment": "撤销二审判决，维持一审判决。", "case_number": "(2017)最高法行再34号"}], "case_summary": {"key_facts": "涉案专利为“一种聊天机器人系统”，专利权人为上海某网络科技股份有限公司。某电脑贸易公司请求宣告该专利无效，理由为说明书未充分公开游戏功能等相关技术方案，不符合专利法第二十六条第三款。专利复审委员会作出决定维持专利有效。一审法院判决维持该决定，二审法院改判撤销决定，最高人民法院再审后撤销二审判决，维持一审判决。争议核心在于游戏服务器是否为区别技术特征及说明书对其公开是否充分。", "disputed_issues": "本专利说明书是否充分公开了游戏功能的实现方式，游戏服务器是否属于本专利区别于现有技术的技术特征，以及如何判断说明书公开充分的标准。", "conclusion": "最高人民法院再审认为，游戏服务器并非本专利与现有技术的区别技术特征，对于共有技术特征无需详细描述，本领域技术人员根据说明书能够实现游戏功能，因此说明书公开充分，撤销二审判决，维持一审判决及被诉决定。", "amount_involved": "", "guiding_points": "本领域技术人员是否能够实现发明技术方案是判断说明书公开是否充分的根本落脚点。发明或者实用新型区别于现有技术的技术特征以及从属权利要求中的附加技术特征应当足够详细地描述，以所属技术领域的技术人员能够实现该技术方案为准。"}}, "eval": {"row_id": "3906", "score": 89.0, "issues": ["guiding_case_number 为空", "judges 为空", "attorneys 为空", "trial_organizations 为空"], "court_case_count": 3, "judge_count": 0, "attorney_count": 0, "provision_count": 2, "evidence_count": 5}}
