{"row_id": "2478", "input": {"id": "2478", "web_name": "人民法院案例库", "case_type": "民事-网络侵权责任纠纷", "storage_no": "2024-18-2-369-002"}, "output": {"guiding_case": {"guiding_case_number": "", "guiding_case_name": "宋某与叶某、广州某计算机系统有限公司网络侵权责任纠纷案", "publication_date": "2022-11-18", "binding_force": "persuasive", "guiding_points": "网络主播在提供网络表演及视听节目服务过程中，引导、放任众多网络用户在直播间内谩骂、侮辱他人，致使他人名誉权遭受侵害的，网络主播应当依法承担侵权责任。", "key_words": ["网络侵权", "名誉权", "网络主播", "直播"], "case_level": "typical_case", "trial_procedure": "second_instance", "storage_no": "2024-18-2-369-002", "source_url": "", "judgment_mean": ""}, "case_type": {"category": "civil", "level1": "网络侵权责任纠纷", "level2": ""}, "court_cases": [{"case_number": "（2022）粤0192民初9098号", "filing_date": "2022-01-01", "judgment_date": "2022-08-19", "trial_level": "first_instance", "trial_procedure": "一审", "court": {"name": "广州互联网法院", "court_level": "basic"}, "status": "judged"}, {"case_number": "（2022）粤01民终21935号", "filing_date": "2022-01-01", "judgment_date": "2022-11-18", "trial_level": "second_instance", "trial_procedure": "二审", "court": {"name": "广东省广州市中级人民法院", "court_level": "intermediate"}, "status": "effective"}], "legal_subjects": [{"name": "宋某", "subject_type": "natural_person", "org_type": "", "credit_code": null, "roles": [{"role_code": "plaintiff", "role_name": "原告", "case_number": "（2022）粤0192民初9098号"}, {"role_code": "appellant", "role_name": "上诉人", "case_number": "（2022）粤01民终21935号"}]}, {"name": "叶某", "subject_type": "natural_person", "org_type": "", "credit_code": null, "roles": [{"role_code": "defendant", "role_name": "被告", "case_number": "（2022）粤0192民初9098号"}, {"role_code": "appellee", "role_name": "被上诉人", "case_number": "（2022）粤01民终21935号"}]}, {"name": "广州某计算机系统有限公司", "subject_type": "organization", "org_type": "company", "credit_code": null, "roles": [{"role_code": "defendant", "role_name": "被告", "case_number": "（2022）粤0192民初9098号"}, {"role_code": "appellee", "role_name": "被上诉人", "case_number": "（2022）粤01民终21935号"}]}], "attorneys": [], "judges": [], "prosecutors": [], "trial_organizations": [], "legal_provisions": [{"case_number": "（2022）粤0192民初9098号", "statute": "民法典", "article": "1024", "paragraph": "", "item": "", "content": "该行为具有违法性，客观上造成宋某社会评价降低。", "citation_position": "related_info", "citation_purpose": "适用依据"}, {"case_number": "（2022）粤0192民初9098号", "statute": "民法典", "article": "1194", "paragraph": "", "item": "", "content": "不足以认定存在“知道或应当知道”侵权行为发生的情形，且直播平台在宋某起诉后提供了侵权用户身份信息，并删除被诉直播回放，未违反平台的法定义务，依法不承担侵权责任。", "citation_position": "related_info", "citation_purpose": "适用依据"}], "evidence": [{"content": "叶某以“全网爆料”“全服吃瓜”方式发布直播，吸引不特定网络用户观看及讨论宋某与游戏玩家间的纠纷。", "evidence_type": "electronic", "submitted_by": "宋某", "is_key_evidence": true}, {"content": "直播间内出现大量侮辱、谩骂宋某的弹幕评论，叶某对此未加以提醒和制止。", "evidence_type": "electronic", "submitted_by": "宋某", "is_key_evidence": true}, {"content": "叶某将载有宋某身份信息的诉讼文书违法向他人提供。", "evidence_type": "documentary", "submitted_by": "宋某", "is_key_evidence": true}], "judgment_results": [{"result_type": "liable", "specific_judgment": "叶某于判决发生法律效力之日起十五日内，使用某直播平台主播账号以直播的方式向宋某公开赔礼道歉，致歉内容须事先经法院审查，直播回放保留天数不少于15日；叶某于判决发生法律效力之日起十五日内向宋某赔偿精神损害抚慰金2万元。", "case_number": "（2022）粤0192民初9098号"}, {"result_type": "dismissed", "specific_judgment": "驳回宋某对广州某计算机系统有限公司的诉讼请求。", "case_number": "（2022）粤0192民初9098号"}, {"result_type": "fully_upheld", "specific_judgment": "驳回上诉，维持原判。", "case_number": "（2022）粤01民终21935号"}], "case_summary": {"key_facts": "宋某是网络游戏玩家，叶某是拥有30余万粉丝的游戏主播。2022年4月，叶某开设直播专场公开评述宋某与他人游戏纠纷，引导网络用户围观，导致直播间出现大量侮辱谩骂宋某的弹幕，叶某未加制止。宋某多次向平台投诉未果。诉讼后，叶某又将载有宋某身份信息的文书泄露，致其持续遭受攻击。宋某遂起诉叶某和平台。", "disputed_issues": "1. 叶某的行为是否构成对宋某名誉权的侵害；2. 游戏直播平台是否尽到合理注意义务，应否承担侵权责任。", "conclusion": "叶某利用直播引导、放任网络用户侮辱宋某，构成名誉权侵害，应赔礼道歉并赔偿精神损害抚慰金2万元；平台在接到有效通知前已及时处理，不承担责任。二审维持原判。", "amount_involved": "2万元", "guiding_points": "网络主播在提供网络表演及视听节目服务过程中，引导、放任众多网络用户在直播间内谩骂、侮辱他人，致使他人名誉权遭受侵害的，网络主播应当依法承担侵权责任。"}}, "eval": {"row_id": "2478", "score": 89.0, "issues": ["guiding_case_number 为空", "judges 为空", "attorneys 为空", "trial_organizations 为空"], "court_case_count": 2, "judge_count": 0, "attorney_count": 0, "provision_count": 2, "evidence_count": 3}}
