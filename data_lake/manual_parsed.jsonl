{"row_id": "manual_1778592452", "input": {"id": "manual_1778592452"}, "output": {"attorneys": [{"case_number": "(2025)最高法知民终727号", "law_firm": "上海段和段（虹桥国际中央商务区）律师事务所", "name": "李源", "representation_for": "上海某医学数据科技有限公司"}, {"case_number": "(2025)最高法知民终727号", "law_firm": "上海段和段（虹桥国际中央商务区）律师事务所", "name": "丁浩", "representation_for": "上海某医学数据科技有限公司"}], "case_summary": {"amount_involved": "", "conclusion": "一审驳回张某伟诉讼请求，二审驳回上诉、维持原判。法院认定张某伟未对涉案专利申请的实质性特点作出创造性贡献，不享有发明人署名权。", "disputed_issues": "张某伟是否对涉案专利申请的实质性特点作出创造性贡献，从而享有发明人署名权。", "guiding_points": "", "key_facts": "张某伟原系某公司员工，担任应用算法负责人。涉案专利申请（申请号202211696280.5）发明人为姚某娟。张某伟主张其为实际发明人，要求添加署名。某公司提交聊天记录证明张某伟仅对专利申请文稿进行批注解答，未参与研发。涉案专利申请已被国家知识产权局驳回。"}, "case_type": {"category": "civil", "level1": "知识产权与竞争纠纷", "level2": "专利权权属、侵权纠纷"}, "court_cases": [{"case_number": "(2025)最高法知民终727号", "court": {"court_level": "supreme", "name": "中华人民共和国最高人民法院"}, "filing_date": "2025-10-20", "judgment_date": "2026-02-27", "status": "effective", "trial_level": "second_instance", "trial_procedure": "二审"}, {"case_number": "(2024)沪73知民初164号", "court": {"court_level": "intermediate", "name": "上海知识产权法院"}, "filing_date": "2024-08-08", "judgment_date": "2025-08-27", "status": "judged", "trial_level": "first_instance", "trial_procedure": "一审"}], "evidence": [{"content": "张某伟与王某晟之间的企业微信聊天记录，显示王某晟发送专利申请文件给张某伟，张某伟回复批注解答问题。", "evidence_type": "electronic_data", "is_key_evidence": true, "submitted_by": "上海某医学数据科技有限公司"}, {"content": "《大专家算法应用初步思路》PPT，张某伟主张为涉案专利申请的技术来源。", "evidence_type": "electronic_data", "is_key_evidence": false, "submitted_by": "张某伟"}, {"content": "涉案专利申请文件（申请号202211696280.5），权利要求书和说明书。", "evidence_type": "documentary", "is_key_evidence": true, "submitted_by": "上海某医学数据科技有限公司"}], "guiding_case": {"binding_force": "reference", "case_level": "reference_case", "guiding_case_name": "张某伟与上海某医学数据科技有限公司发明专利发明人署名权纠纷二审民事判决书", "guiding_case_number": "", "guiding_points": "", "judgment_mean": "", "key_words": [], "publication_date": "2026-03-16", "source_url": "", "storage_no": "", "trial_procedure": "二审"}, "judges": [{"case_number": "(2025)最高法知民终727号", "name": "刘晓梅", "role": "presiding_judge"}, {"case_number": "(2025)最高法知民终727号", "name": "徐卓斌", "role": "judge"}, {"case_number": "(2025)最高法知民终727号", "name": "黄中华", "role": "judge"}, {"case_number": "(2025)最高法知民终727号", "name": "王宁", "role": "clerk"}, {"case_number": "(2025)最高法知民终727号", "name": "高佳钰", "role": "clerk"}, {"case_number": "(2025)最高法知民终727号", "name": "孙静仪", "role": "clerk"}], "judgment_results": [{"case_number": "(2025)最高法知民终727号", "result_type": "dismissed", "specific_judgment": "驳回上诉，维持原判。二审案件受理费50元，由张某伟负担。"}, {"case_number": "(2024)沪73知民初164号", "result_type": "dismissed", "specific_judgment": "驳回原告张某伟的诉讼请求。案件受理费人民币50元，由原告张某伟负担。"}], "legal_provisions": [{"article": "16", "case_number": "(2024)沪73知民初164号", "citation_position": "judgment_reason", "citation_purpose": "适用依据", "content": "发明人或者设计人有权在专利文件中写明自己是发明人或者设计人。", "item": "", "paragraph": "1", "statute": "中华人民共和国专利法"}, {"article": "14", "case_number": "(2024)沪73知民初164号", "citation_position": "judgment_reason", "citation_purpose": "适用依据", "content": "专利法第十六条所称发明人或者设计人，是指对发明创造的实质性特点作出创造性贡献的人。", "item": "", "paragraph": "", "statute": "中华人民共和国专利法实施细则"}, {"article": "177", "case_number": "(2025)最高法知民终727号", "citation_position": "judgment_reason", "citation_purpose": "适用依据", "content": "第二审人民法院对上诉案件，经过审理，按照下列情形，分别处理：（一）原判决、裁定认定事实清楚，适用法律正确的，以判决、裁定方式驳回上诉，维持原判决、裁定；", "item": "1", "paragraph": "1", "statute": "中华人民共和国民事诉讼法"}], "legal_subjects": [{"credit_code": null, "name": "张某伟", "org_type": null, "roles": [{"case_number": "(2025)最高法知民终727号", "role_code": "appellant", "role_name": "上诉人"}, {"case_number": "(2024)沪73知民初164号", "role_code": "plaintiff", "role_name": "一审原告"}], "subject_type": "natural_person"}, {"credit_code": null, "name": "上海某医学数据科技有限公司", "org_type": "company", "roles": [{"case_number": "(2025)最高法知民终727号", "role_code": "respondent", "role_name": "被上诉人"}, {"case_number": "(2024)沪73知民初164号", "role_