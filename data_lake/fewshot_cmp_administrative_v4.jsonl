{"row_id": "1611", "input": {"id": "1611", "web_name": "人民法院案例库", "case_type": "行政-行政确认", "storage_no": "2024-12-3-007-008"}, "output": {"guiding_case": {"guiding_case_number": "", "guiding_case_name": "西乌珠穆沁旗某车床加工部诉西乌珠穆沁旗人力资源和社会保障局工伤保险资格认定案", "publication_date": "2023-12-29", "binding_force": "persuasive", "guiding_points": "根据《工伤保险条例》相关规定，职工在工作时间和工作场所内，因工作原因受到事故伤害的，应当认定为工伤。此处的“工作原因”应当根据实际情况作出合理判断。对于职工在工作时间、工作地点为本单位利益从事非本人固定岗位（或所分配工种）的其他相关工作（例如协助他人搬运货物等）所受伤害，应当属于“工作原因”，也应当理解为“与履行工作职责相关”的工作。在符合法定情形下，社会保险行政部门根据《工伤保险条例》认定为工伤，符合最大限度保障职工权益的立法本意，人民法院应予支持。对“工作原因”和职工是否从事与本职相关的工作认定，不宜作片面理解和不合理的限定。", "key_words": ["行政", "行政确认", "工伤保险资格认定", "认定工伤", "工作原因", "维护单位利益", "社会主义核心价值观"], "case_level": "typical_case", "trial_procedure": "再审", "storage_no": "2024-12-3-007-008", "source_url": "https://rmfyalk.court.gov.cn", "judgment_mean": ""}, "case_type": {"category": "administrative", "level1": "行政", "level2": "行政确认"}, "court_cases": [{"case_number": "(2023)内2526行初10号", "filing_date": "2023-01-01", "judgment_date": "2023-06-30", "trial_level": "first_instance", "trial_procedure": "一审", "court": {"name": "内蒙古自治区西乌珠穆沁旗人民法院", "court_level": "basic"}, "status": "appealed"}, {"case_number": "(2023)内25行终55号", "filing_date": "2023-01-01", "judgment_date": "2023-08-28", "trial_level": "second_instance", "trial_procedure": "二审", "court": {"name": "内蒙古自治区锡林郭勒盟中级人民法院", "court_level": "intermediate"}, "status": "effective"}, {"case_number": "(2023)内行申871号", "filing_date": "2023-01-01", "judgment_date": "2023-12-29", "trial_level": "retrial", "trial_procedure": "再审审查", "court": {"name": "内蒙古自治区高级人民法院", "court_level": "high"}, "status": "judged"}], "legal_subjects": [{"name": "西乌珠穆沁旗某车床加工部", "subject_type": "organization", "org_type": "individual_business", "credit_code": null, "roles": [{"role_code": "plaintiff", "role_name": "原告", "case_number": "(2023)内2526行初10号"}, {"role_code": "appellant", "role_name": "上诉人", "case_number": "(2023)内25行终55号"}, {"role_code": "retrial_applicant", "role_name": "再审申请人", "case_number": "(2023)内行申871号"}]}, {"name": "西乌珠穆沁旗人力资源和社会保障局", "subject_type": "organization", "org_type": "government_agency", "credit_code": null, "roles": [{"role_code": "defendant", "role_name": "被告", "case_number": "(2023)内2526行初10号"}, {"role_code": "appellee", "role_name": "被上诉人", "case_number": "(2023)内25行终55号"}, {"role_code": "retrial_respondent", "role_name": "再审被申请人", "case_number": "(2023)内行申871号"}]}, {"name": "李某岗", "subject_type": "natural_person", "org_type": null, "credit_code": null, "roles": [{"role_code": "third_party", "role_name": "第三人", "case_number": "(2023)内2526行初10号"}, {"role_code": "third_party", "role_name": "第三人", "case_number": "(2023)内25行终55号"}, {"role_code": "third_party", "role_name": "第三人", "case_number": "(2023)内行申871号"}]}], "attorneys": [], "judges": [], "prosecutors": [], "trial_organizations": [], "legal_provisions": [{"case_number": "(2023)内2526行初10号", "statute": "工伤保险条例", "article": "14", "paragraph": "", "item": "1", "content": "职工有下列情形之一的，应当认定为工伤：（一）在工作时间和工作场所内，因工作原因受到事故伤害的……", "citation_position": "judgment_reason", "citation_purpose": "适用依据"}, {"case_number": "(2023)内2526行初10号", "statute": "最高人民法院关于审理工伤保险行政案件若干问题的规定", "article": "4", "paragraph": "", "item": "4", "content": "社会保险行政部门认定下列情形为工伤的，人民法院应予支持：……（四）其他与履行工作职责相关，在工作时间及合理区域内受到伤害的。", "citation_position": "judgment_reason", "citation_purpose": "说理依据"}], "evidence": [{"content": "西乌旗某车床加工部提交《证明》，拟证明李某与客户之间形成义务帮工关系，应当由被帮工人承担赔偿责任。", "evidence_type": "documentary", "submitted_by": "西乌珠穆沁旗某车床加工部", "is_key_evidence": true}], "judgment_results": [{"result_type": "dismissed", "specific_judgment": "驳回西乌旗某车床加工部的诉讼请求。", "case_number": "(2023)内2526行初10号"}, {"result_type": "dismissed", "specific_judgment": "驳回上诉，维持原判。", "case_number": "(2023)内25行终55号"}, {"result_type": "dismissed", "specific_judgment": "驳回西乌旗某车床加工部的再审申请。", "case_number": "(2023)内行申871号"}], "case_summary": {"key_facts": "2019年10月17日，西乌旗某车床加工部职工李某岗在协助客户搬货装车过程中左脚被砸伤。西乌旗人社局认定为工伤。某车床加工部不服，提起行政诉讼，主张李某岗本职为车床工，协助搬货并非本职工作，不应认定为工伤。一审、二审均驳回其诉讼请求，再审申请亦被驳回。", "disputed_issues": "李某岗受伤是否属于《工伤保险条例》规定的“工作原因”，是否应认定为工伤。", "conclusion": "法院认为，李某岗协助搬货系为维护单位利益，与其工作职责相关联，属于与履行工作职责相关的活动，所受伤害符合工伤认定条件。驳回某车床加工部的诉讼请求，维持工伤认定决定。", "amount_involved": "", "guiding_points": "根据《工伤保险条例》相关规定，职工在工作时间和工作场所内，因工作原因受到事故伤害的，应当认定为工伤。此处的“工作原因”应当根据实际情况作出合理判断。对于职工在工作时间、工作地点为本单位利益从事非本人固定岗位（或所分配工种）的其他相关工作（例如协助他人搬运货物等）所受伤害，应当属于“工作原因”，也应当理解为“与履行工作职责相关”的工作。在符合法定情形下，社会保险行政部门根据《工伤保险条例》认定为工伤，符合最大限度保障职工权益的立法本意，人民法院应予支持。对“工作原因”和职工是否从事与本职相关的工作认定，不宜作片面理解和不合理的限定。"}}, "eval": {"row_id": "1611", "score": 89.0, "issues": ["guiding_case_number 为空", "judges 为空", "attorneys 为空", "trial_organizations 为空"], "court_case_count": 3, "judge_count": 0, "attorney_count": 0, "provision_count": 2, "evidence_count": 1}}
{"row_id": "2847", "input": {"id": "2847", "web_name": "人民法院案例库", "case_type": "行政-专利相关行政案件", "storage_no": "2024-13-3-024-005"}, "output": {"guiding_case": {"guiding_case_number": "", "guiding_case_name": "日本某株式会社诉国家知识产权局专利无效宣告请求行政纠纷案", "publication_date": "2023-12-11", "binding_force": "persuasive", "guiding_points": "判断优先权是否成立，应当审查在后申请的权利要求限定的内容能否从在先申请的专利文件中直接、毫无疑义地得出。权利要求中限定的某些内容如给药特征，虽然在新颖性、创造性判断中可能因不具有实质限定作用而不予考虑，但在优先权审查中应予考虑。", "key_words": ["行政", "发明专利权无效", "优先权", "相同主题", "给药特征"], "case_level": "typical_case", "trial_procedure": "二审", "storage_no": "2024-13-3-024-005", "source_url": "https://rmfyalk.court.gov.cn", "judgment_mean": ""}, "case_type": {"category": "administrative", "level1": "专利相关行政案件", "level2": ""}, "court_cases": [{"case_number": "(2019)京73行初9748号", "filing_date": "2019-01-01", "judgment_date": "2020-10-26", "trial_level": "first_instance", "trial_procedure": "一审", "court": {"name": "北京知识产权法院", "court_level": "special"}, "status": "appealed"}, {"case_number": "(2019)京73行初9751号", "filing_date": "2019-01-01", "judgment_date": "2020-10-26", "trial_level": "first_instance", "trial_procedure": "一审", "court": {"name": "北京知识产权法院", "court_level": "special"}, "status": "appealed"}, {"case_number": "(2021)最高法知行终344号", "filing_date": "2021-01-01", "judgment_date": "2023-12-11", "trial_level": "second_instance", "trial_procedure": "二审", "court": {"name": "最高人民法院", "court_level": "supreme"}, "status": "effective"}, {"case_number": "(2021)最高法知行终371号", "filing_date": "2021-01-01", "judgment_date": "2023-12-11", "trial_level": "second_instance", "trial_procedure": "二审", "court": {"name": "最高人民法院", "court_level": "supreme"}, "status": "effective"}], "legal_subjects": [{"name": "日本某株式会社", "subject_type": "organization", "org_type": "company", "credit_code": null, "roles": [{"role_code": "plaintiff", "role_name": "原告", "case_number": "(2019)京73行初9748号"}, {"role_code": "plaintiff", "role_name": "原告", "case_number": "(2019)京73行初9751号"}, {"role_code": "appellant", "role_name": "上诉人", "case_number": "(2021)最高法知行终344号"}, {"role_code": "appellant", "role_name": "上诉人", "case_number": "(2021)最高法知行终371号"}]}, {"name": "国家知识产权局", "subject_type": "organization", "org_type": "government_agency", "credit_code": null, "roles": [{"role_code": "defendant", "role_name": "被告", "case_number": "(2019)京73行初9748号"}, {"role_code": "defendant", "role_name": "被告", "case_number": "(2019)京73行初9751号"}, {"role_code": "appellee", "role_name": "被上诉人", "case_number": "(2021)最高法知行终344号"}, {"role_code": "appellee", "role_name": "被上诉人", "case_number": "(2021)最高法知行终371号"}]}, {"name": "某药业公司", "subject_type": "organization", "org_type": "company", "credit_code": null, "roles": [{"role_code": "third_party", "role_name": "第三人", "case_number": "(2019)京73行初9748号"}, {"role_code": "third_party", "role_name": "第三人", "case_number": "(2019)京73行初9751号"}, {"role_code": "third_party", "role_name": "第三人", "case_number": "(2021)最高法知行终344号"}, {"role_code": "third_party", "role_name": "第三人", "case_number": "(2021)最高法知行终371号"}]}], "attorneys": [], "judges": [], "prosecutors": [], "trial_organizations": [], "legal_provisions": [{"case_number": "(2021)最高法知行终344号", "statute": "专利法", "article": "29", "paragraph": "1", "item": "", "content": "申请人自发明或者实用新型在外国第一次提出专利申请之日起十二个月内，又在中国就相同主题提出专利申请的，可以享有优先权。判断在后申请与在先申请是否属于相同主题，应判断在后申请的权利要求限定的内容是否能从在先申请文件中直接、毫无疑义地得出。", "citation_position": "judgment_reason", "citation_purpose": "适用依据"}, {"case_number": "(2021)最高法知行终344号", "statute": "专利法", "article": "22", "paragraph": "2", "item": "", "content": "新颖性，是指该发明或者实用新型不属于现有技术；也没有任何单位或者个人就同样的发明或者实用新型在申请日以前向国务院专利行政部门提出过申请，并记载在申请日以后公布的专利申请文件或者公告的专利文件中。", "citation_position": "judgment_reason", "citation_purpose": "说理依据"}, {"case_number": "(2021)最高法知行终344号", "statute": "专利审查指南", "article": "", "paragraph": "", "item": "", "content": "第二部分第八章第4.6.2节规定，所属领域的技术人员认为该技术方案不能从在先申请中直接和毫无疑义地得出，则该在先申请不能作为在后申请要求优先权的基础。第二部分第三章第4.1.2节规定，相同主题的发明或者实用新型，是指技术领域、所解决的技术问题、技术方案和预期的效果相同的发明或者实用新型。", "citation_position": "judgment_reason", "citation_purpose": "说理依据"}], "evidence": [], "judgment_results": [{"result_type": "dismissed", "specific_judgment": "驳回日本某株式会社的诉讼请求。", "case_number": "(2019)京73行初9748号"}, {"result_type": "dismissed", "specific_judgment": "驳回日本某株式会社的诉讼请求。", "case_number": "(2019)京73行初9751号"}, {"result_type": "remanded", "specific_judgment": "一、撤销北京知识产权法院(2019)京73行初9748、9751号行政判决；二、撤销国家知识产权局第38951、38952号无效宣告请求审查决定；三、国家知识产权局就某药业公司提出的无效宣告请求重新作出审查决定。", "case_number": "(2021)最高法知行终344号"}, {"result_type": "remanded", "specific_judgment": "一、撤销北京知识产权法院(2019)京73行初9748、9751号行政判决；二、撤销国家知识产权局第38951、38952号无效宣告请求审查决定；三、国家知识产权局就某药业公司提出的无效宣告请求重新作出审查决定。", "case_number": "(2021)最高法知行终371号"}], "case_summary": {"key_facts": "日本某株式会社系两项发明专利的专利权人，某药业公司针对该专利权向国家知识产权局提出无效宣告请求。国家知识产权局作出决定，认为该专利权利要求不能享有优先权，权利要求不具备新颖性，宣告无效。日本某株式会社不服，提起行政诉讼。一审驳回其诉讼请求，上诉至最高人民法院。", "disputed_issues": "涉案专利的优先权是否成立，即在优先权核实中是否应当考虑权利要求中限定的给药特征；被诉决定认定证据4为现有技术是否正确。", "conclusion": "最高人民法院二审认为，在优先权核实中，应考虑权利要求限定的全部内容，包括给药特征，并采用“直接、毫无疑义地得出”的标准。因证据4未记载给药特征，不能作为现有技术，故撤销一审判决和被诉决定，责令国家知识产权局重新作出审查决定。", "amount_involved": "", "guiding_points": "判断优先权是否成立，应当审查在后申请的权利要求限定的内容能否从在先申请的专利文件中直接、毫无疑义地得出。权利要求中限定的某些内容如给药特征，虽然在新颖性、创造性判断中可能因不具有实质限定作用而不予考虑，但在优先权审查中应予考虑。"}}, "eval": {"row_id": "2847", "score": 82.0, "issues": ["guiding_case_number 为空", "judges 为空", "attorneys 为空", "trial_organizations 为空", "legal_provisions[2].article 为空", "evidence 为空"], "court_case_count": 4, "judge_count": 0, "attorney_count": 0, "provision_count": 3, "evidence_count": 0}}
