{"row_id": "23127", "input": {"id": "23127", "web_name": "人民法院案例库", "case_type": "刑事-虐待罪", "storage_no": "2026-02-1-214-001"}, "output": {"guiding_case": {"guiding_case_number": "", "guiding_case_name": "何某英虐待案", "publication_date": "2020-05-25", "binding_force": "persuasive", "guiding_points": "1.由共同生活的父（母）、祖父（母）等近亲属抚养，并与该近亲属的未婚同居者处于较为稳定的共同生活状态的未成年人，应当认定为刑法第二百六十条规定的“家庭成员”。前述近亲属的未婚同居者对未成年人实施虐待行为，情节恶劣的，依法以虐待罪论处。 2.被虐待的未成年人因年幼无法行使告诉权利，属于虐待罪中“被害人没有能力告诉”的情形，符合刑法第二百六十条第三款规定的，可以依法由检察机关提起公诉。", "key_words": ["刑事", "虐待罪", "家庭成员", "共同生活", "没有告诉能力", "公诉程序", "未成年人"], "case_level": "typical_case", "trial_procedure": "一审", "storage_no": "2026-02-1-214-001", "source_url": "https://rmfyalk.court.gov.cn/view/content.html?id=rD2YKYQRU%2Fp%2B1EHC4HS%2BoKwU5cFidxoNVqOaKpKyT5g%3D&lib=ck", "judgment_mean": ""}, "case_type": {"category": "criminal", "level1": "刑事", "level2": "虐待罪"}, "court_cases": [{"case_number": "(2020)川1523刑初28号", "filing_date": "2020-01-01", "judgment_date": "2020-05-25", "trial_level": "first_instance", "trial_procedure": "一审", "court": {"name": "江安县人民法院", "court_level": "basic"}, "status": "effective"}], "legal_subjects": [{"name": "何某英", "subject_type": "natural_person", "org_type": null, "credit_code": null, "roles": [{"role_code": "defendant_criminal", "role_name": "被告人", "case_number": "(2020)川1523刑初28号"}]}, {"name": "唐某某", "subject_type": "natural_person", "org_type": null, "credit_code": null, "roles": [{"role_code": "victim", "role_name": "被害人", "case_number": "(2020)川1523刑初28号"}]}, {"name": "江安县人民检察院", "subject_type": "organization", "org_type": "procuratorate", "credit_code": null, "roles": [{"role_code": "prosecutor", "role_name": "公诉机关", "case_number": "(2020)川1523刑初28号"}]}], "attorneys": [], "judges": [], "prosecutors": [{"name": "", "role": "public_prosecutor", "unit": "江安县人民检察院", "case_number": "(2020)川1523刑初28号"}], "trial_organizations": [], "legal_provisions": [{"case_number": "(2020)川1523刑初28号", "statute": "刑法", "article": "260", "paragraph": "1", "item": "", "content": "虐待家庭成员，情节恶劣的，处二年以下有期徒刑、拘役或者管制。", "citation_position": "judgment_reason", "citation_purpose": "适用依据"}, {"case_number": "(2020)川1523刑初28号", "statute": "刑法", "article": "260", "paragraph": "3", "item": "", "content": "虐待家庭成员，情节恶劣的，告诉的才处理，但被害人没有能力告诉，或者因受到强制、威吓无法告诉的除外。", "citation_position": "judgment_reason", "citation_purpose": "适用依据"}, {"case_number": "(2020)川1523刑初28号", "statute": "民法典", "article": "1045", "paragraph": "3", "item": "", "content": "配偶、父母、子女和其他共同生活的近亲属为家庭成员。", "citation_position": "judgment_reason", "citation_purpose": "说理依据"}, {"case_number": "(2020)川1523刑初28号", "statute": "最高人民法院、最高人民检察院、公安部、司法部关于依法办理家庭暴力犯罪案件的意见", "article": "", "paragraph": "", "item": "", "content": "家庭暴力犯罪不仅发生在家庭成员之间，还发生在具有监护、扶养、寄养、同居等关系的共同生活人员之间。", "citation_position": "judgment_reason", "citation_purpose": "说理依据"}, {"case_number": "(2020)川1523刑初28号", "statute": "反家庭暴力法", "article": "37", "paragraph": "", "item": "", "content": "家庭成员以外共同生活的人之间实施的暴力行为，参照本法规定执行。", "citation_position": "related_law", "citation_purpose": "说理依据"}], "evidence": [{"content": "经鉴定，唐某某因外伤致肢体瘢痕的损伤程度为轻伤二级，右前臂皮肤被咬伤、面部及左脚前掌皮肤被烫伤及背部皮肤挫伤的损伤程度均为轻微伤。", "evidence_type": "forensic", "submitted_by": "公诉机关", "is_key_evidence": true}], "judgment_results": [{"result_type": "convicted", "specific_judgment": "被告人何某英犯虐待罪，判处有期徒刑一年六个月。", "case_number": "(2020)川1523刑初28号"}], "case_summary": {"key_facts": "2018年9月至2019年11月，被害人唐某某（时年5岁）因父母离异，由祖父唐某勇及祖父的同居者被告人何某英共同生活。期间，何某英多次以唐某某不听话为由，采取打、咬、掐、烫等方式虐待唐某某，致其肢体瘢痕轻伤二级及面部、脚掌、背部多处轻微伤。案发后，何某英取得唐某某父亲唐某金的谅解。因被害人没有能力告诉，江安县人民检察院提起公诉。", "disputed_issues": "1.被害人唐某某是否应认定为虐待罪中的“家庭成员”；2.本案是否应适用公诉程序，由检察机关提起公诉。", "conclusion": "法院以虐待罪判处被告人何某英有期徒刑一年六个月。", "amount_involved": "", "guiding_points": "1.由共同生活的父（母）、祖父（母）等近亲属抚养，并与该近亲属的未婚同居者处于较为稳定的共同生活状态的未成年人，应当认定为刑法第二百六十条规定的“家庭成员”。前述近亲属的未婚同居者对未成年人实施虐待行为，情节恶劣的，依法以虐待罪论处。 2.被虐待的未成年人因年幼无法行使告诉权利，属于虐待罪中“被害人没有能力告诉”的情形，符合刑法第二百六十条第三款规定的，可以依法由检察机关提起公诉。"}}, "eval": {"row_id": "23127", "score": 84.0, "issues": ["guiding_case_number 为空", "judges 为空", "attorneys 为空", "trial_organizations 为空", "legal_provisions[3].article 为空"], "court_case_count": 1, "judge_count": 0, "attorney_count": 0, "provision_count": 5, "evidence_count": 1}}
{"row_id": "2478", "input": {"id": "2478", "web_name": "人民法院案例库", "case_type": "民事-网络侵权责任纠纷", "storage_no": "2024-18-2-369-002"}, "output": {"guiding_case": {"guiding_case_number": "", "guiding_case_name": "宋某诉叶某、广州某计算机系统有限公司网络侵权责任纠纷案", "publication_date": "", "binding_force": "persuasive", "guiding_points": "网络主播在提供网络表演及视听节目服务过程中，引导、放任众多网络用户在直播间内谩骂、侮辱他人，致使他人名誉权遭受侵害的，网络主播应当依法承担侵权责任。", "key_words": ["民事", "网络侵权责任", "名誉权", "直播", "跟帖评论"], "case_level": "typical_case", "trial_procedure": "二审", "storage_no": "2024-18-2-369-002", "source_url": "https://rmfyalk.court.gov.cn", "judgment_mean": ""}, "case_type": {"category": "civil", "level1": "网络侵权责任纠纷", "level2": ""}, "court_cases": [{"case_number": "(2022)粤0192民初9098号", "filing_date": "2022-01-01", "judgment_date": "2022-08-19", "trial_level": "first_instance", "trial_procedure": "一审", "court": {"name": "广州互联网法院", "court_level": "special"}, "status": "effective"}, {"case_number": "(2022)粤01民终21935号", "filing_date": "2022-01-01", "judgment_date": "2022-11-18", "trial_level": "second_instance", "trial_procedure": "二审", "court": {"name": "广东省广州市中级人民法院", "court_level": "intermediate"}, "status": "effective"}], "legal_subjects": [{"name": "宋某", "subject_type": "natural_person", "org_type": null, "credit_code": null, "roles": [{"role_code": "plaintiff", "role_name": "原告", "case_number": "(2022)粤0192民初9098号"}, {"role_code": "appellant", "role_name": "上诉人", "case_number": "(2022)粤01民终21935号"}]}, {"name": "叶某", "subject_type": "natural_person", "org_type": null, "credit_code": null, "roles": [{"role_code": "defendant", "role_name": "被告", "case_number": "(2022)粤0192民初9098号"}, {"role_code": "appellee", "role_name": "被上诉人", "case_number": "(2022)粤01民终21935号"}]}, {"name": "广州某计算机系统有限公司", "subject_type": "organization", "org_type": "company", "credit_code": null, "roles": [{"role_code": "defendant", "role_name": "被告", "case_number": "(2022)粤0192民初9098号"}, {"role_code": "appellee", "role_name": "被上诉人", "case_number": "(2022)粤01民终21935号"}]}], "attorneys": [], "judges": [], "prosecutors": [], "trial_organizations": [], "legal_provisions": [{"case_number": "(2022)粤01民终21935号", "statute": "民法典", "article": "1024", "paragraph": "", "item": "", "content": "《民法典》第一千零二十四条：民事主体享有名誉权。任何组织或者个人不得以侮辱、诽谤等方式侵害他人的名誉权。本案中，主播叶某引导、放任网络用户对宋某进行侮辱、谩骂，造成宋某社会评价降低，构成名誉权侵权。", "citation_position": "judgment_reason", "citation_purpose": "适用依据"}, {"case_number": "(2022)粤01民终21935号", "statute": "民法典", "article": "1194", "paragraph": "", "item": "", "content": "《民法典》第一千一百九十四条：网络用户、网络服务提供者利用网络侵害他人民事权益的，应当承担侵权责任。法律另有规定的，依照其规定。法院认为游戏直播平台运营者不知晓用户真实身份，难以实时监控，不足以认定存在知道或应当知道，且接到通知后采取了必要措施，故不承担侵权责任。", "citation_position": "judgment_reason", "citation_purpose": "适用依据"}], "evidence": [{"content": "叶某2022年4月某日发布的直播回放，内容为公开评述宋某与他人的游戏纠纷，并引导网络用户对宋某进行侮辱、谩骂。", "evidence_type": "electronic", "submitted_by": "宋某", "is_key_evidence": true}, {"content": "叶某将载有宋某身份信息的诉讼文书向他人提供，导致宋某持续遭受人身攻击。", "evidence_type": "documentary", "submitted_by": "宋某", "is_key_evidence": true}], "judgment_results": [{"result_type": "liable", "specific_judgment": "一、叶某向宋某赔礼道歉；二、叶某赔偿宋某精神损害抚慰金2万元。", "case_number": "(2022)粤0192民初9098号"}, {"result_type": "not_liable", "specific_judgment": "驳回宋某对广州某计算机系统有限公司的诉讼请求。", "case_number": "(2022)粤0192民初9098号"}, {"result_type": "fully_upheld", "specific_judgment": "驳回上诉，维持原判。", "case_number": "(2022)粤01民终21935号"}], "case_summary": {"key_facts": "原告宋某系某网络游戏玩家，与游戏主播叶某就游戏道具分配产生矛盾。2022年4月，叶某开设专场直播公开评述纠纷，吸引网络用户观看，直播间出现大量侮辱宋某的言论。宋某认为叶某侵害其名誉权，并要求平台删除直播回放未果。宋某起诉后，叶某还违法提供载有宋某身份信息的诉讼文书给他人。一审法院判决叶某赔礼道歉并赔偿精神损害抚慰金2万元，平台不承担责任。宋某上诉，二审维持原判。", "disputed_issues": "1. 叶某直播行为是否构成对宋某名誉权的侵害；2. 游戏直播平台运营者是否应当承担侵权责任。", "conclusion": "叶某构成名誉权侵权，应向宋某赔礼道歉并赔偿精神损害抚慰金2万元；游戏直播平台已尽到法定义务，不承担侵权责任。", "amount_involved": "2万元", "guiding_points": "网络主播引导、放任网络用户谩骂、侮辱他人，侵害他人名誉权的，应当依法承担侵权责任。"}}, "eval": {"row_id": "2478", "score": 89.0, "issues": ["guiding_case_number 为空", "judges 为空", "attorneys 为空", "trial_organizations 为空"], "court_case_count": 2, "judge_count": 0, "attorney_count": 0, "provision_count": 2, "evidence_count": 2}}
