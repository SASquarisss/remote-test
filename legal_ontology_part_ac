  # 案由/法律
  has_case_type:
    from: CourtCase
    to: CaseType
    cardinality: one_to_many
    description: "案件具有案由类型"
  
  cites:
    from: CourtCase
    to: LegalProvision
    cardinality: many_to_many
    attributes: [citation_position, citation_purpose, context]
