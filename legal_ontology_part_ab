    is_a: Organization
    required: [firm_type, license_number]
    optional: [partners, practice_areas]
    firm_type_enum: [partnership, limited_liability, sole_practitioner]
    description: "律师事务所"
  
  ExpertInstitution:
    is_a: Organization
    required: [expertise_fields, accreditation_number]
    optional: [accreditation_authority, validity_period]
    description: "鉴定机构"
  
  District:
    is_a: JudicialEntity
    required: [name, code]
    optional: [administrative_level, parent_district]
    description: "辖区"
  
  LegalRole:
    is_a: JudicialEntity
    required: [name, code]
    optional: [description, permissions]
    role_enum: [plaintiff, defendant, third_party, witness, agent, expert_witness, interpreter, prosecutor, applicant, respondent, relator] # 修正：拼写错误
    description: "法律角色"

  # 案件层
  CourtCase:
    is_a: JudicialEntity
    required: [case_number, case_type_id, filing_date, court_id, status, trial_level]
    optional: [claim_amount, cause_of_action, summary, related_cases, first_instance_case_number]
    trial_level_enum: [first_instance, second_instance, retrial]
    status_enum: [filing, trial, judged, effective, appealed, retried, executing, terminated] # 补全状态枚举
    description: "法院案件"
  
  TrialOrganization:
    is_a: JudicialEntity
    required: [organization_type, case_id]
    optional: [judge_ids, presiding_judge_id, clerk_id] # 修正：members→judge_ids 语义明确
    organization_type_enum: [sole_judge, collegiate_bench, judicial_committee]
    description: "审判组织"
  
  JudgmentResult:
    is_a: JudicialEntity
    required: [case_id, result_type, judgment_date, effective_date]
    optional: [sentence_term, compensation_amount, reasoning]
    result_type_enum: [guilty, not_guilty, liable, not_liable, dismissed, withdrawn]
    description: "裁判结果"
  
  ExecutionInfo:
    is_a: JudicialEntity
    required: [case_id, execution_status, execution_court_id]
    optional: [execution_amount, execution_measures, completion_date]
    execution_status_enum: [pending, in_progress, completed, terminated]
    description: "执行信息"
  
  LegalDocument:
    is_a: JudicialEntity
    required: [document_type, case_id, creation_date, signed_by_judge_id, issuing_court_id]
    optional: [document_number, content_hash, file_path, content]
    document_type_enum: [judgment, ruling, mediation, order, notice, indictment, petition] # 补全司法文书
    description: "法律文书"
  
  Evidence:
    is_a: JudicialEntity
    required: [evidence_type, case_id, submitter_id, submission_date, examination_status, admission_status]
    optional: [description, file_path, chain_of_custody]
    evidence_type_enum: [document, physical, digital, testimony, expert_opinion]
    examination_status_enum: [not_examined, examined]
    admission_status_enum: [admitted, not_admitted]
    probative_force_enum: [valid, invalid]
    description: "证据"
  
  DisputeFocus:
    is_a: JudicialEntity
    required: [case_id, content]
    description: "案件争议焦点"
  
  Fact:
    is_a: JudicialEntity
    required: [case_id, content]
    description: "案件事实"

relations:
  # 审理关系
  tried_by:
    from: CourtCase
    to: TrialOrganization
    cardinality: one_to_one
    description: "案件由审判组织审理"
  
  presides_over:
    from: Judge
    to: TrialOrganization
    cardinality: one_to_one
    description: "法官主持审判组织"
  
  undertakes:
    from: Judge
    to: CourtCase
    cardinality: one_to_many
